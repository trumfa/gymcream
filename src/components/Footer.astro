---
import { FALLBACK_INFO_PAGES } from "@src/data/cmsDefaults";
import { getLocale } from "astro-i18n-aut";
import translations from "@utils/t.ts";

const currentLocale = getLocale(Astro.url);
const nav = translations(Astro.url);
---

<!-- FOOTER -->
<footer x-data="footerState" class="bg-black border-t border-gray-900 pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-4">
                    <img src="/logos/logo white GC no GC.png" alt="Gym Cream Logo" class="h-9 w-auto object-contain" />
                </div>
                <p class="text-gray-400 font-sans text-sm max-w-sm leading-relaxed">
                    {nav.footer_tagline}
                </p>
            </div>
            
            <!-- Links Informatius que obren Finestra Flotant (Modal) -->
            <div>
                <h5 class="font-display text-gcYellow uppercase text-xs tracking-widest mb-4">{nav.footer_informacio}</h5>
                <ul class="space-y-3 text-xs text-gray-400 font-sans">
                    <li>
                        <a href="/gymcreamer" data-astro-reload class="hover:text-gcYellow font-bold transition-colors text-left flex items-center gap-2 text-gcYellow">
                            <svg class="w-4 h-4 stroke-current" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM12 8v4l3 3"/></svg>
                            <span>{nav.btn_soc_gymcreamer}</span>
                        </a>
                    </li>
                    <li>
                        <button @click="openInfo('enviaments')" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0c-.565.058-.987.538-.987 1.106v11.177h12a1.125 1.125 0 011.125 1.125v.75"/></svg>
                            <span>{nav.footer_enviaments}</span>
                        </button>
                    </li>
                    <li>
                        <button @click="openInfo('termes')" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                            <span>{nav.footer_termes}</span>
                        </button>
                    </li>
                    <li>
                        <button @click="openInfo('privacitat')" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                            <span>{nav.footer_privacitat}</span>
                        </button>
                    </li>
                    <li>
                        <button @click="openCookieModal()" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM12 7a1 1 0 100-2 1 1 0 000 2zm-3 4a1 1 0 100-2 1 1 0 000 2zm6 1a1 1 0 100-2 1 1 0 000 2zm-4 4a1 1 0 100-2 1 1 0 000 2zm4-1a1 1 0 100-2 1 1 0 000 2z"/></svg>
                            <span>{nav.footer_cookies}</span>
                        </button>
                    </li>
                    <li>
                        <button @click="openInfo('talles')" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v16.5m0-16.5h16.5m-16.5 0L12 12m-8.25 8.25h16.5m0-16.5v16.5m0 0L12 12"/></svg>
                            <span>{nav.footer_talles}</span>
                        </button>
                    </li>
                    <li>
                        <button @click="openInfo('contacte')" class="hover:text-white transition-colors text-left cursor-pointer flex items-center gap-2">
                            <svg class="w-4 h-4 stroke-gray-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a.75.75 0 01-.812-.54.75.75 0 01.102-.736A5.97 5.97 0 005.65 17.5 8.25 8.25 0 013 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>
                            <span>{nav.footer_contacte_atencio}</span>
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Pagament Segur -->
            <div>
                <h5 class="font-display text-gcYellow uppercase text-xs tracking-widest mb-4">{nav.footer_pagament_segur}</h5>
                <div class="flex gap-2 flex-wrap items-center">
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" class="h-4 object-contain" alt="Stripe">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b5/PayPal.svg" class="h-4 object-contain" alt="PayPal">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/f/f2/Google_Pay_Logo.svg" class="h-4 object-contain" alt="Google Pay">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b0/Apple_Pay_logo.svg" class="h-4 object-contain" alt="Apple Pay">
                    </div>
                </div>
            </div>
        </div>
        
        <div class="border-t border-gray-900 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500 font-sans">
            <p>&copy; 2026 GYM CREAM. {nav.footer_rights}</p>
            <p class="mt-2 md:mt-0 font-display">{nav.footer_designed_irony}</p>
        </div>
    </div>

    <!-- FINESTRA FLOTANT / MODAL D'INFORMACIÓ -->
    <div 
        x-show="infoModalOpen" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 bg-black/85 z-[150] flex items-center justify-center p-4 backdrop-blur-md"
        @click.self="infoModalOpen = false"
        x-cloak
    >
        <div class="bg-gcDark border-2 border-gcYellow/60 w-full max-w-2xl p-6 sm:p-8 space-y-6 text-white shadow-2xl relative max-h-[85vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                <div class="flex items-center gap-3">
                    <span class="text-2xl" x-text="activeInfo?.icon || 'ℹ️'"></span>
                    <h3 class="font-display font-black text-xl uppercase tracking-wider text-gcYellow" x-text={`activeInfo?.title || "${nav.footer_modal_default_title}"`}></h3>
                </div>
                <button @click="infoModalOpen = false" class="text-gray-400 hover:text-white p-1 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="font-sans text-sm text-gray-300 leading-relaxed space-y-4">
                <div x-html="activeInfo?.content || ''"></div>

                <!-- Formulari interactiu si la finestra activa és Contacte -->
                <template x-if="activeInfoKey === 'contacte'">
                    <div class="pt-4 border-t border-gray-800 mt-4">
                        <h4 class="font-display font-black text-sm uppercase text-gcYellow tracking-wider mb-3">{nav.footer_contacte_directe}</h4>
                        
                        <template x-if="contactSent">
                            <div class="p-4 bg-emerald-950/80 border border-emerald-500 text-emerald-200 text-xs mb-4 rounded flex items-center gap-2">
                                <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>{nav.footer_contact_success}</span>
                            </div>
                        </template>

                        <template x-if="contactError">
                            <div class="p-4 bg-red-950/80 border border-red-500 text-red-200 text-xs mb-4 rounded" x-text="contactError"></div>
                        </template>

                        <form @submit.prevent="submitContactForm()" class="space-y-3">
                            <div>
                                <label class="block text-xs uppercase text-gray-300 font-bold mb-1">{nav.footer_label_email}</label>
                                <input 
                                    type="email" 
                                    x-model="contactEmail" 
                                    placeholder={nav.footer_placeholder_email}
                                    class="w-full bg-black border border-gray-800 text-white p-2.5 text-xs focus:border-gcYellow focus:outline-none rounded font-sans"
                                    required
                                />
                            </div>

                            <div>
                                <label class="block text-xs uppercase text-gray-300 font-bold mb-1">{nav.footer_label_missatge}</label>
                                <textarea 
                                    x-model="contactMessage" 
                                    rows="3" 
                                    placeholder={nav.footer_placeholder_missatge}
                                    class="w-full bg-black border border-gray-800 text-white p-2.5 text-xs focus:border-gcYellow focus:outline-none rounded font-sans"
                                    required
                                ></textarea>
                            </div>

                            <button 
                                type="submit" 
                                :disabled="contactSending"
                                class="w-full bg-gcYellow text-black font-display font-black text-xs uppercase py-3 hover:bg-white transition-colors cursor-pointer tracking-wider rounded disabled:opacity-50 disabled:cursor-wait"
                            >
                                <span x-text={`contactSending ? "${nav.footer_enviant}" : "${nav.footer_enviar_missatge}"`}></span>
                            </button>
                        </form>
                    </div>
                </template>
            </div>

            <div class="border-t border-gray-800 pt-4 flex justify-end">
                <button 
                    @click="infoModalOpen = false" 
                    class="bg-gcYellow text-black font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors cursor-pointer"
                >
                    {nav.footer_tancar}
                </button>
            </div>
        </div>
    </div>
</footer>

<script is:inline define:vars={{ fallbackInfoPages: FALLBACK_INFO_PAGES, currentLocale: currentLocale, i18nAlertCamps: nav.footer_alert_camps, i18nContactError: nav.footer_contact_error }}>
    const registerFooterState = () => {
        if (!window.Alpine) return;
        Alpine.data('footerState', () => ({
            infoModalOpen: false,
            activeInfoKey: 'enviaments',
            contactEmail: '',
            contactMessage: '',
            contactSent: false,
            infoPages: fallbackInfoPages,

            init() {
                fetch('/api/cms/InfoPages?lang=' + currentLocale)
                    .then(r => r.ok ? r.json() : null)
                    .then(data => {
                        if (Array.isArray(data) && data.length > 0) {
                            const keyed = {};
                            data.forEach(page => { keyed[page.id] = page; });
                            this.infoPages = keyed;
                        }
                    })
                    .catch(() => {});
            },

            openInfo(key) {
                this.activeInfoKey = key;
                this.contactSent = false;
                this.infoModalOpen = true;
            },

            openCookieModal() {
                window.dispatchEvent(new CustomEvent('open-cookie-preferences'));
            },

            contactSending: false,
            contactError: '',

            async submitContactForm() {
                if (!this.contactEmail || !this.contactEmail.includes('@') || !this.contactMessage.trim()) {
                    alert(i18nAlertCamps);
                    return;
                }
                this.contactError = '';
                this.contactSending = true;
                try {
                    const res = await fetch('/api/contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: this.contactEmail, message: this.contactMessage })
                    });
                    if (!res.ok) throw new Error('Error del servidor');
                } catch (e) {
                    this.contactSending = false;
                    this.contactError = i18nContactError;
                    return;
                }
                this.contactSending = false;
                this.contactSent = true;
                this.contactEmail = '';
                this.contactMessage = '';
                setTimeout(() => {
                    this.contactSent = false;
                }, 6000);
            },

            get activeInfo() {
                return this.infoPages[this.activeInfoKey] || Object.values(this.infoPages)[0] || null;
            }
        }));
    };

    if (window.Alpine) {
        registerFooterState();
    } else {
        document.addEventListener('alpine:init', registerFooterState);
    }
</script>
