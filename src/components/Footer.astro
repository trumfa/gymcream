---
import { DEFAULT_INFO_PAGES } from "@src/data/cmsDefaults";
---

<!-- FOOTER -->
<footer x-data="footerState" class="bg-black border-t border-gray-900 pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-4">
                    <img src="/logos/logo white GC no GC.png" alt="Gym Cream Logo" class="h-9 w-auto object-contain" />
                </div>
                <p class="text-gray-400 font-sans text-sm max-w-sm leading-relaxed">
                    Marca independent d'equipament i apparel de gimnàs. Trencant els estereotips del fitness des del 2026.
                </p>
            </div>
            
            <!-- Links Informatius que obren Finestra Flotant (Modal) -->
            <div>
                <h5 class="font-display text-gcYellow uppercase text-xs tracking-widest mb-4">Informació</h5>
                <ul class="space-y-3 text-sm text-gray-400 font-sans">
                    <li><button @click="openInfo('enviaments')" class="hover:text-white transition-colors text-left cursor-pointer">🚚 Enviaments i Devolucions</button></li>
                    <li><button @click="openInfo('termes')" class="hover:text-white transition-colors text-left cursor-pointer">📜 Termes i Condicions</button></li>
                    <li><button @click="openInfo('privacitat')" class="hover:text-white transition-colors text-left cursor-pointer">🔒 Política de Privacitat</button></li>
                    <li><button @click="openInfo('talles')" class="hover:text-white transition-colors text-left cursor-pointer">📏 Guia de Talles</button></li>
                    <li><button @click="openInfo('contacte')" class="hover:text-white transition-colors text-left cursor-pointer">💬 Contacte i Atenció</button></li>
                    <li class="pt-2 border-t border-gray-900">
                        <a href="/admin" class="hover:text-gcYellow text-xs transition-colors flex items-center gap-1.5 text-gray-500">
                            <span>⚙️</span> Panell de Control (CMS)
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Pagament Segur -->
            <div>
                <h5 class="font-display text-gcYellow uppercase text-xs tracking-widest mb-4">Pagament Segur</h5>
                <div class="flex gap-2 flex-wrap items-center">
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" class="h-4 object-contain" alt="Stripe">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b5/PayPal.svg" class="h-4 object-contain" alt="PayPal">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/f/f2/Google_Pay_Logo.svg" class="h-4 object-contain" alt="Google Pay">
                    </div>
                    <div class="bg-white p-2 rounded flex items-center justify-center h-8 w-16">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b0/Apple_Pay_logo.svg" class="h-4 object-contain" alt="Apple Pay">
                    </div>
                </div>
            </div>
        </div>
        
        <div class="border-t border-gray-900 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500 font-sans">
            <p>&copy; 2026 GYM CREAM. Tots els drets reservats.</p>
            <p class="mt-2 md:mt-0 font-display">DESIGNED WITH IRONY</p>
        </div>
    </div>

    <!-- FINESTRA FLOTANT / MODAL D'INFORMACIÓ -->
    <div 
        x-show="infoModalOpen" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 bg-black/85 z-[150] flex items-center justify-center p-4 backdrop-blur-md"
        @click.self="infoModalOpen = false"
        x-cloak
    >
        <div class="bg-gcDark border-2 border-gcYellow/60 w-full max-w-2xl p-6 sm:p-8 space-y-6 text-white shadow-2xl relative max-h-[85vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                <div class="flex items-center gap-3">
                    <span class="text-2xl" x-text="activeInfo?.icon || 'ℹ️'"></span>
                    <h3 class="font-display font-black text-xl uppercase tracking-wider text-gcYellow" x-text="activeInfo?.title || 'Informació'"></h3>
                </div>
                <button @click="infoModalOpen = false" class="text-gray-400 hover:text-white p-1 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="font-sans text-sm text-gray-300 leading-relaxed space-y-4" x-html="activeInfo?.content || ''">
            </div>

            <div class="border-t border-gray-800 pt-4 flex justify-end">
                <button 
                    @click="infoModalOpen = false" 
                    class="bg-gcYellow text-black font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors cursor-pointer"
                >
                    Tancar
                </button>
            </div>
        </div>
    </div>
</footer>

<script is:inline define:vars={{ defaultInfoPages: DEFAULT_INFO_PAGES }}>
    document.addEventListener('alpine:init', () => {
        Alpine.data('footerState', () => ({
            infoModalOpen: false,
            activeInfoKey: 'enviaments',

            openInfo(key) {
                this.activeInfoKey = key;
                this.infoModalOpen = true;
            },

            get activeInfo() {
                return defaultInfoPages[this.activeInfoKey] || defaultInfoPages['enviaments'];
            }
        }));
    });
</script>
