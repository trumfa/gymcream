                                        <button 
                                            @click="submitRestock()"
                                            class="bg-red-600 hover:bg-red-700 text-white font-display text-xs font-bold uppercase px-4 py-2.5 transition-colors cursor-pointer"
                                        >
                                            {nav.modal_avisam_btn}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                </div>
            </div>
        </div>
    </template>

    <!-- 🔍 FULLSCREEN PHOTO LIGHTBOX / ZOOM -->
    <template x-if="modalZoomOpen && modalActiveImage">
        <div class="fixed inset-0 z-[160] bg-black/95 flex flex-col items-center justify-center p-4">
            <button 
