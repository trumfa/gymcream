---
import { FALLBACK_CATEGORIES, FALLBACK_PRODUCTS } from "@src/data/cmsDefaults";
import translations from "@utils/t.ts";
import { getLocale } from "astro-i18n-aut";

const nav = translations(Astro.url);
const currentLocale = getLocale(Astro.url);
---

<!-- SECCIÓ DE PRODUCTES (FONS BLANC) -->
<section id="catalog" x-data="catalogState" class="bg-white border-y border-gray-200 text-black py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4 border-b border-gray-200 pb-8">
            <div>
                <span class="font-display text-xs text-black font-extrabold uppercase tracking-widest bg-gcYellow px-2.5 py-1 inline-block">{nav.botiga_eyebrow}</span>
                <h2 class="font-serif italic text-3xl md:text-5xl text-black mt-3">
                    {nav.botiga_title}
                </h2>
            </div>
            
            <!-- Filtres ràpids per categoria carregats des de les categories del CMS -->
            <div class="flex flex-wrap gap-2 text-xs font-sans font-bold uppercase tracking-wider">
                <template x-for="cat in categories" :key="cat.id">
                    <button 
                        @click="activeCategory = cat.slug || cat.name; $dispatch('filter-category', cat.slug || cat.name)"
                        :class="[
                            cat.isSpecial ? 
                            (activeCategory === (cat.slug || cat.name) ? 'bg-red-600 text-white font-bold border-red-600' : 'bg-red-50 text-red-700 border-red-200 hover:bg-red-100') :
                            (activeCategory === (cat.slug || cat.name) ? 'bg-black text-white font-bold border-black' : 'bg-gray-100 text-gray-800 hover:bg-gray-200 border-gray-300')
                        ]"
                        class="px-4 py-2 border transition-colors flex items-center gap-1 cursor-pointer rounded-sm"
                    >
                        <template x-if="cat.isSpecial"><span>🔥</span></template>
                        <span x-text="cat.name"></span>
                    </button>
                </template>
            </div>
        </div>

        <!-- Graella de Productes -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <template x-for="product in visibleProducts" :key="product.id">
                <div class="group relative bg-white border border-gray-200 hover:border-black transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-sm hover:shadow-md rounded-sm">
                    
                    <!-- Badges (Rebaixat, Bestseller, Esgotat, Nou Drop) -->
                    <div class="absolute top-3 left-3 flex flex-col gap-1 z-20">
                        <template x-if="product.isSoldOut || (product.stock !== undefined && product.stock <= 0)">
                            <span class="bg-red-600 text-white font-sans text-[10px] font-bold px-2.5 py-1 uppercase tracking-wider shadow">
                                {nav.badge_esgotat}
                            </span>
                        </template>
                        <template x-if="!(product.isSoldOut || (product.stock !== undefined && product.stock <= 0)) && product.isSale">
                            <span class="bg-red-600 text-white font-sans text-[10px] font-bold px-2.5 py-1 uppercase tracking-wider shadow flex items-center gap-1">
                                🔥 {nav.badge_rebaixat} <span x-text="product.discountPercent ? `-${product.discountPercent}%` : ''"></span>
                            </span>
                        </template>
                        <template x-if="!(product.isSoldOut || (product.stock !== undefined && product.stock <= 0)) && !product.isSale && product.badge">
                            <span 
                                :class="product.badge === 'BESTSELLER' ? 'bg-gcYellow text-black font-bold' : 'bg-black text-white font-bold'"
                                class="font-sans text-[10px] px-2.5 py-1 uppercase tracking-wider shadow"
                                x-text="product.badge"
                            ></span>
                        </template>
                    </div>

                    <!-- Imatges Front / Back Hover Preview -->
                    <div 
                        @click="$dispatch('open-product-modal', product)"
                        class="relative aspect-[3/4] bg-[#FAF9F5] overflow-hidden cursor-pointer group-hover:opacity-95 transition-opacity"
                    >
                        <img 
                            :src="product.imageFront" 
                            :alt="product.name" 
                            :class="product.isSoldOut || (product.stock !== undefined && product.stock <= 0) ? 'opacity-40 grayscale-[40%]' : ''"
                            class="w-full h-full object-cover transition-opacity duration-500 group-hover:opacity-0 absolute inset-0"
                        />
                        <img 
                            :src="product.imageBack || product.imageFront" 
                            :alt="`${product.name} detall`" 
                            :class="product.isSoldOut || (product.stock !== undefined && product.stock <= 0) ? 'opacity-30 grayscale-[40%]' : ''"
                            class="w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100 absolute inset-0"
                        />
                        
                        <!-- Overlay indicator per a Esgotat -->
                        <template x-if="product.isSoldOut || (product.stock !== undefined && product.stock <= 0)">
                            <div class="absolute inset-0 bg-black/40 backdrop-blur-[1px] flex items-center justify-center p-4">
                                <span class="border-2 border-red-500 text-red-500 font-sans font-bold text-xs uppercase tracking-widest px-4 py-2 rotate-[-6deg] bg-white/90">
                                    {nav.badge_sense_estoc}
                                </span>
                            </div>
                        </template>
                    </div>

                    <!-- Informació del Producte -->
                    <div class="p-5 flex-1 flex flex-col justify-between bg-white border-t border-gray-100">
                        <div>
                            <div class="text-[10px] font-sans font-bold text-gray-500 uppercase tracking-widest mb-1" x-text="categoryLabel(product.category)"></div>
                            <a
                                :href="product.url"
                                data-astro-reload
                                class="font-serif text-base font-bold tracking-wide hover:text-gray-700 transition-colors line-clamp-2 min-h-[2.5rem] flex items-center text-black"
                                x-text="product.name"
                            ></a>

                            <!-- Display de Preu vell ratllat + preu nou -->
                            <div class="mt-2 mb-2 flex items-baseline gap-2">
                                <template x-if="product.oldPrice || product.isSale">
                                    <span class="font-sans text-xs text-gray-400 line-through" x-text="`${product.oldPrice ? product.oldPrice.toFixed(2) : (product.price * 1.25).toFixed(2)} €`"></span>
                                </template>
                                <span 
                                    :class="product.isSale ? 'text-red-600 font-extrabold' : 'text-black font-extrabold'"
                                    class="font-sans text-xl" 
                                    x-text="`${product.price.toFixed(2)} €`"
                                ></span>
                            </div>

                            <!-- Badge Distintiu Oficial Gym Cream -->
                            <div class="mb-3 flex items-center gap-1.5 text-[10px] text-gray-600 font-sans">
                                <span class="text-black font-bold">🛡️</span>
                                <span>{nav.product_distintiu}</span>
                            </div>
                        </div>
                        
                        <!-- Botons Acció Fora: Botó "+INFO" i Botó "Subscriure" si està esgotat -->
                        <div class="space-y-2 pt-3 border-t border-gray-100">
                            <!-- Botó +INFO (Sempre visible) -->
                            <button 
                                @click="$dispatch('open-product-modal', product)"
                                class="w-full bg-black text-white font-sans text-xs font-bold uppercase py-3 hover:bg-gcYellow hover:text-black transition-all cursor-pointer flex items-center justify-center gap-2 rounded-sm"
                            >
                                <svg class="w-4 h-4 text-white hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>{nav.btn_info_detalls}</span>
                            </button>

                            <!-- Botó Subscriure't si el producte està ESGOTAT -->
                            <template x-if="product.isSoldOut || (product.stock !== undefined && product.stock <= 0)">
                                <button 
                                    @click="$dispatch('open-restock-modal', product)"
                                    class="w-full bg-red-50 text-red-700 hover:bg-red-100 font-sans text-[11px] font-bold uppercase py-2.5 border border-red-200 transition-all cursor-pointer flex items-center justify-center gap-1.5 rounded-sm"
                                >
                                    <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v2.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                    </svg>
                                    {nav.btn_avisam_estoc}
                                </button>
                            </template>
                        </div>

                    </div>
                </div>
            </template>
        </div>
    </div>
</section>

<script is:inline define:vars={{ fallbackCategories: FALLBACK_CATEGORIES, fallbackProducts: FALLBACK_PRODUCTS, currentLocale: currentLocale }}>
    const registerCatalogState = () => {
        if (!window.Alpine) return;
        Alpine.data('catalogState', () => ({
            activeCategory: 'TOT',
            allProducts: fallbackProducts,
            categories: fallbackCategories,

            init() {
                this.loadData();

                window.addEventListener('filter-category', (e) => {
                    this.activeCategory = e.detail;
                });
            },

            async loadData() {
                try {
                    const [prodRes, catRes] = await Promise.all([
                        fetch('/api/cms/Products?lang=' + currentLocale),
                        fetch('/api/cms/Categories?lang=' + currentLocale),
                    ]);
                    if (prodRes.ok) {
                        const prod = await prodRes.json();
                        if (Array.isArray(prod) && prod.length > 0) {
                            this.allProducts = prod.map(p => ({ ...p, url: this.buildProductUrl(p) }));
                        }
                    }
                    if (catRes.ok) {
                        const cat = await catRes.json();
                        if (Array.isArray(cat) && cat.length > 0) this.categories = cat;
                    }
                } catch (e) {}
            },

            get visibleProducts() {
                const cat = (this.activeCategory || 'TOT').toUpperCase();
                if (cat === 'TOT' || cat === 'TOTS') {
                    return this.allProducts;
                }
                if (cat === 'REBAIXATS' || cat === 'REBAIXAT') {
                    return this.allProducts.filter(p => p.isSale || (p.oldPrice && p.oldPrice > p.price));
                }
                return this.allProducts.filter(p => p.category && p.category.toUpperCase() === cat);
            },

            // Products.category sempre és estable en català (mai es
            // tradueix, és la clau de coincidència). Per mostrar-la a
            // pantalla, busquem la categoria amb aquest slug i n'agafem
            // el nom ja traduït. Si no la trobem (categoria esborrada,
            // etc.) mostrem el valor cru tal qual, per no deixar-ho buit.
            categoryLabel(categorySlug) {
                if (!categorySlug) return '';
                const match = this.categories.find(c => (c.slug || c.name) === categorySlug);
                return match ? match.name : categorySlug;
            },

            // Genera la URL real i indexable d'un producte:
            // /botiga/{slug-del-nom}-{id}  (o /es/botiga/..., /en/botiga/...
            // segons l'idioma actual). Es crida NOMÉS un cop, en carregar
            // les dades (loadData), i es guarda com product.url — mai es
            // recalcula al propi enllaç, per evitar qualsevol fallada
            // silenciosa d'Alpine en temps de render.
            buildProductUrl(product) {
                try {
                    const rawName = (product && product.name) ? String(product.name) : 'producte';
                    const slug = rawName
                        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                        .toLowerCase()
                        .replace(/[^a-z0-9]+/g, '-')
                        .replace(/(^-|-$)/g, '');
                    const id = product && product.id ? product.id : '0';
                    const prefix = currentLocale === 'ca' ? '' : `/${currentLocale}`;
                    return `${prefix}/botiga/${slug}-${id}`;
                } catch (err) {
                    console.error('Error generant la URL del producte:', err);
                    const prefix = currentLocale === 'ca' ? '' : `/${currentLocale}`;
                    return `${prefix}/botiga`;
                }
            },
        }));
    };

    if (window.Alpine) {
        registerCatalogState();
    } else {
        document.addEventListener('alpine:init', registerCatalogState);
    }
</script>
