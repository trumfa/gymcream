---
/**
 * @desc This is the base head component that is used on all pages.
 */

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "@styles/global.css";
import "@fontsource-variable/inter";
import { SEO } from "astro-seo";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from "@src/consts";
import { getLocale, getLocaleUrl } from "astro-i18n-aut";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const locale = getLocale(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImageWithDomain = new URL("/meta/opengraph.png", Astro.site).toString();

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = "/blog-placeholder-1.jpg" } = Astro.props;

// Alternes d'idioma (hreflang): li diem a Google que aquesta mateixa
// pàgina existeix en català, castellà i anglès, i quina és la versió
// per defecte quan cap coincideix amb l'idioma del cercador.
const SUPPORTED_LOCALES = ["ca", "es", "en"];
const hreflangAlternates = SUPPORTED_LOCALES.map((lc) => ({
	lang: lc,
	url: new URL(getLocaleUrl(Astro.url, lc), Astro.site).toString(),
}));
const xDefaultUrl = new URL(getLocaleUrl(Astro.url, "ca"), Astro.site).toString();

// Dades estructurades (JSON-LD) de l'organització — ajuden Google a
// entendre qui ets més enllà del text pla, i habiliten resultats
// enriquits a la cerca.
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "ClothingStore",
	name: "Gym Cream",
	url: SITE_URL,
	logo: new URL("/logos/logo primary GC no GC.png", Astro.site).toString(),
	image: resolvedImageWithDomain,
	description: SITE_DESCRIPTION,
	sameAs: [],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />

<!-- Primary Meta Tags -->
<title>{title}</title>

<!-- Hreflang: versions per idioma d'aquesta mateixa pàgina -->
{hreflangAlternates.map((alt) => (
	<link rel="alternate" hreflang={alt.lang} href={alt.url} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Dades estructurades JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

<SEO
	title={title}
	description={description}
	canonical={canonicalURL}
	openGraph={{
		basic: {
			url: canonicalURL,
			title: title,
			type: "website",
			image: resolvedImageWithDomain,
		},
		optional: {
			description: description,
			siteName: title,
			locale: locale,
		},
		image: {
			alt: title,
		},
	}}
	twitter={{
		card: "summary_large_image",
		title: title,
		description: description,
		image: resolvedImageWithDomain,
		imageAlt: title,
	}}
	extend={{
		// extending the default link tags
		link: [
			{
				rel: "icon",
				type: "image/png",
				href: "/logos/logo primary GC no GC.png",
			},
			{
				rel: "icon",
				type: "image/png",
				sizes: "32x32",
				href: "/favicon-32x32.png",
			},
			{
				rel: "icon",
				type: "image/png",
				sizes: "64x64",
				href: "/favicon-64x64.png",
			},
			{
				rel: "icon",
				type: "image/x-icon",
				href: "/favicon.ico",
			},
			{
				rel: "apple-touch-icon",
				sizes: "180x180",
				href: "/apple-touch-icon.png",
			},
		],
		// extending the default meta tags
		meta: [
			{
				name: "generator",
				content: Astro.generator,
			},
			{
				name: "viewport",
				content: "width=device-width,initial-scale=1",
			},
		],
	}}
/>
