---
import { FALLBACK_SLIDES } from "@src/data/cmsDefaults";
---

<!-- HERO SECTION AMB CARRUSEL DINÀMIC (FOTOS I VÍDEOS) A PANTALLA COMPLETA -->
<section x-data="heroState" class="relative w-full h-screen overflow-hidden bg-gcDark">

    <!-- CAPA 1: CARRUSEL D'IMATGES / VÍDEOS -->
    <!-- Només es carrega el <img>/<video> real del slide actiu i del següent
         (via shouldLoad). Els altres slides existeixen al DOM per mantenir
         la transició, però sense src fins que els toca el torn — així no es
         descarreguen les 5 imatges de cop en carregar la pàgina. -->
    <div class="absolute inset-0 z-0">
        <template x-for="(slide, index) in slides" :key="slide.id || index">
            <div
                x-show="activeSlide === index"
                x-transition:enter="transition-opacity duration-1000"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition-opacity duration-1000"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                class="absolute inset-0"
            >
                <template x-if="slide.type === 'video' && shouldLoad(index)">
                    <video :src="slide.url" class="w-full h-full object-cover opacity-60" autoplay loop muted playsinline></video>
                </template>
                <template x-if="slide.type !== 'video' && shouldLoad(index)">
                    <img
                        :src="slide.url"
                        :loading="index === 0 ? 'eager' : 'lazy'"
                        :fetchpriority="index === 0 ? 'high' : 'auto'"
                        decoding="async"
                        class="w-full h-full object-cover opacity-60"
                        :alt="slide.title || 'Hero slide'"
                        @error="console.warn(`[HeroCarousel] No s'ha pogut carregar la imatge del slide ${index}: ${slide.url}. Comprova que el nom de fitxer a /public/slides coincideix exactament (majúscules/minúscules incloses) amb la URL del Sheet.`)"
                    />
                </template>
            </div>
        </template>
    </div>

    <!-- CAPA 2: LLETRES DE LA MARCA NEÓ -->
    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center pointer-events-none text-center px-4">
        <template x-if="currentSlideData">
            <div>
                <span class="font-display text-xs sm:text-sm text-gcYellow uppercase tracking-[0.3em] font-extrabold mb-2 block drop-shadow-lg" x-text="currentSlideData.subtitle || 'COL·LECCIÓ 2026'"></span>
                <h1 id="neonText" class="font-display text-[13vw] sm:text-[10vw] md:text-[9vw] font-black uppercase tracking-tighter leading-none neon-text-overlay text-center" x-text="currentSlideData.title || 'GYM CREAM'">
                </h1>
            </div>
        </template>
    </div>

    <!-- BOTÓ BOTIGA: perímetre groc, cos transparent -->
    <a
        href="/botiga"
        data-astro-reload
        class="absolute bottom-28 sm:bottom-24 z-20 left-1/2 transform -translate-x-1/2 border-2 border-gcYellow text-gcYellow bg-transparent hover:bg-gcYellow hover:text-black font-display font-extrabold text-[11px] sm:text-sm uppercase tracking-widest px-6 sm:px-12 py-2.5 sm:py-3.5 transition-all duration-300 cursor-pointer whitespace-nowrap"
    >
        Botiga
    </a>

    <!-- FLETXA CAP A LA COMUNITAT GYMCREAMER: en mòbil només la fletxa (sense text, per no envair les ratlletes de progrés) -->
    <a href="#comunitat" class="absolute bottom-4 sm:bottom-6 z-20 left-1/2 transform -translate-x-1/2 flex flex-col items-center gap-1 group cursor-pointer">
        <span class="hidden sm:block text-white/60 group-hover:text-gcYellow text-[10px] font-display uppercase tracking-widest transition-colors">Comunitat Gymcreamer</span>
        <svg class="w-5 h-5 sm:w-4 sm:h-4 text-white/60 group-hover:text-gcYellow transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </a>

    <!-- GUIONS DE PROGRÉS PER SLIDE + PAUSA, cantonada inferior dreta -->
    <div class="absolute bottom-4 sm:bottom-6 right-3 sm:right-6 z-20 flex items-center gap-2">
        <div class="flex items-center gap-1">
            <template x-for="(slide, index) in slides" :key="'dash-' + index">
                <button
                    @click="goToSlide(index)"
                    class="relative h-1 w-4 sm:w-8 rounded-full bg-white/25 overflow-hidden cursor-pointer"
                    :aria-label="`Ves a la slide ${index + 1}`"
                >
                    <template x-if="index < activeSlide">
                        <div class="absolute inset-0 bg-gcPink rounded-full"></div>
                    </template>
                    <template x-if="index === activeSlide">
                        <div
                            class="absolute inset-0 bg-gcPink rounded-full origin-left progress-fill-bar"
                            :style="`animation-play-state: ${paused ? 'paused' : 'running'}`"
                            @animationend="nextSlide()"
                        ></div>
                    </template>
                </button>
            </template>
        </div>

        <button @click="togglePause()" class="text-white/80 hover:text-gcPink transition-colors cursor-pointer shrink-0" :aria-label="paused ? 'Reprendre el carrusel' : 'Pausar el carrusel'">
            <template x-if="!paused">
                <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
            </template>
            <template x-if="paused">
                <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </template>
        </button>
    </div>
</section>

<style>
    @keyframes progressFillBar {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
    }
    .progress-fill-bar {
        animation: progressFillBar 5s linear forwards;
    }
</style>

<script is:inline define:vars={{ fallbackSlides: FALLBACK_SLIDES }}>
    const registerHeroState = () => {
        if (!window.Alpine) return;
        Alpine.data('heroState', () => ({
            slides: fallbackSlides,
            activeSlide: 0,
            paused: false,

            // Índexs de slide que ja tenen dret a carregar la seva imatge/vídeo
            // real. Comença només amb el 0 (el que es veu primer, el LCP) i es
            // va ampliant a mesura que el carrusel avança, en comptes de
            // descarregar-ho tot de cop en carregar la pàgina.
            loadedIndices: new Set([0]),

            shouldLoad(index) {
                return this.loadedIndices.has(index);
            },

            preloadNext() {
                if (!this.slides || this.slides.length === 0) return;
                const next = (this.activeSlide + 1) % this.slides.length;
                this.loadedIndices.add(next);
            },

            async init() {
                try {
                    const res = await fetch('/api/cms/Slides');
                    if (res.ok) {
                        const data = await res.json();
                        if (Array.isArray(data) && data.length > 0) {
                            this.slides = data;
                        } else {
                            console.warn('[HeroCarousel] /api/cms/Slides ha respost buit o amb format inesperat, es fa servir el fallback.');
                        }
                    } else {
                        console.warn(`[HeroCarousel] /api/cms/Slides ha respost ${res.status}, es fa servir el fallback.`);
                    }
                } catch (e) {
                    console.warn('[HeroCarousel] Error connectant amb /api/cms/Slides, es fa servir el fallback.', e);
                }

                // Reinicia el set de càrrega amb els slides definitius i
                // pre-carrega ja el segon perquè estigui llest per la
                // transició quan toqui, sense fer-ho amb tots.
                this.loadedIndices = new Set([0]);
                this.preloadNext();
            },

            get currentSlideData() {
                if (this.slides && this.slides[this.activeSlide]) {
                    return this.slides[this.activeSlide];
                }
                return fallbackSlides[0];
            },

            nextSlide() {
                if (this.paused) return;
                this.activeSlide = (this.activeSlide + 1) % this.slides.length;
                this.preloadNext();
            },

            goToSlide(index) {
                this.activeSlide = index;
                this.loadedIndices.add(index);
                this.preloadNext();
            },

            togglePause() {
                this.paused = !this.paused;
            }
        }));
    };

    if (window.Alpine) {
        registerHeroState();
    } else {
        document.addEventListener('alpine:init', registerHeroState);
    }
</script>
