---

<!-- HERO SECTION AMB CARRUSEL I OVERLAY DE TEXT -->
<section class="relative h-screen flex flex-col items-center justify-center overflow-hidden bg-gcDark">
    
    <!-- CAPA 1: CARRUSEL D'IMATGES -->
    <div id="hero-carousel" class="absolute inset-0 z-0">
        <!-- Slide 1 -->
        <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-100">
            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop" class="w-full h-full object-cover opacity-60" alt="Gym 1">
        </div>
        <!-- Slide 2 -->
        <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-0">
            <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?q=80&w=2070&auto=format&fit=crop" class="w-full h-full object-cover opacity-60" alt="Gym 2">
        </div>
        <!-- Slide 3 -->
        <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-0">
            <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=2070&auto=format&fit=crop" class="w-full h-full object-cover opacity-60" alt="Gym 3">
        </div>
    </div>

    <!-- CAPA 2: LLETRES DE LA MARCA NEÓ (Vora directa sobre la imatge, animació via JS) -->
    <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
        <h1 id="neonText" class="font-display text-[18vw] md:text-[14vw] font-black uppercase tracking-tighter leading-none neon-text-overlay text-center px-4 mt-20" style="opacity: 0;">
            GYM<br>CREAM
        </h1>
    </div>

    <!-- CAPA 3: BOTÓ D'ACCIÓ -->
    <div class="absolute bottom-12 sm:bottom-20 z-20 w-full text-center px-4">
        <a href="#catalog" class="inline-block bg-gcYellow text-black font-display font-extrabold text-xs sm:text-sm uppercase tracking-widest px-8 sm:px-12 py-4 sm:py-5 hover:bg-white transition-all duration-300 shadow-[0_0_25px_rgba(255,230,0,0.5)]">
            Entra a la Botiga
        </a>
    </div>
    
    <!-- Línia de desplaçament subtil -->
    <div class="absolute bottom-4 z-20 left-1/2 transform -translate-x-1/2 flex flex-col items-center animate-bounce">
        <span class="text-white/50 text-[10px] font-display uppercase tracking-widest mb-1">Scroll</span>
        <svg class="w-4 h-4 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>
</section>

<script>
    // CARRUSEL D'IMATGES I ANIMACIÓ DE TEXT NEÓ
    const slides = document.querySelectorAll('#hero-carousel .slide');
    const neonText = document.getElementById('neonText');
    let currentSlide = 0;
    
    function triggerNeonFade() {
        if (!neonText) return;
        neonText.style.transition = 'none';
        neonText.style.opacity = '0';
        void neonText.offsetWidth;
        neonText.style.transition = 'opacity 3.8s ease-in';
        neonText.style.opacity = '1';
    }

    setTimeout(triggerNeonFade, 100);

    if (slides.length > 1) {
        setInterval(() => {
            slides[currentSlide].classList.remove('opacity-100');
            slides[currentSlide].classList.add('opacity-0');
            
            currentSlide = (currentSlide + 1) % slides.length;
            
            slides[currentSlide].classList.remove('opacity-0');
            slides[currentSlide].classList.add('opacity-100');
            
            triggerNeonFade();
        }, 4000); 
    }
</script>
