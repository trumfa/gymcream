---
import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import { FALLBACK_BRAND_ASSETS } from "@src/data/cmsDefaults";
---

<Layout title="Gym Cream — Sóc Gymcreamer & Moviment DIY" description="Som una marca oberta (Open Brand). Descarrega els nostres logos de franc per fer-te la teva roba o aconsegueix la Línia Oficial.">
    <!-- CONTINGUT PRINCIPAL OPEN BRAND — ESTÈTICA 'L'ART DE L'ANTÍTESI' -->
    <main 
        x-data="openBrandState"
        class="pt-20 sm:pt-24 bg-gcClassic text-black min-h-screen"
    >

        <!-- 1. HERO + FILOSOFIA -->
        <section class="py-14 sm:py-20 border-b border-gray-300 relative bg-gcClassic">
            <Container>
                <div class="max-w-3xl mx-auto text-center">
                    <div class="h-20 sm:h-28 max-w-xs mx-auto mb-8 flex items-center justify-center">
                        <img src="/logos/logo GC Black.png" alt="Gym Cream Logo Black" class="h-full w-auto object-contain" />
                    </div>
                </div>

                <div class="max-w-2xl sm:max-w-3xl mx-auto font-serif text-base sm:text-lg text-gray-800 leading-relaxed space-y-5 text-justify">
                    <p>
                        Els Gymcreamers vam néixer d'un esgotament profund. Cansats de les cares de gos d'alguns que es pensen que la quota del gimnàs es paguen amb els muscles.
                    </p>
                    <p>
                        Creiem en la disciplina ferotge sota la barra del press banca, però també creiem en devorar canalons o galetes sense cap mena de remordiment o menjar jarret de porc com a font de proteïna.
                    </p>
                    <p class="font-bold text-black">
                        L'equilibri no és menjar arròs amb pollastre; l'equilibri és fer exactament allò que et dona la gana.
                    </p>
                </div>

                <!-- DOS VIES -->
                <div class="max-w-2xl sm:max-w-4xl mx-auto mt-14">
                    <p class="text-center font-serif italic text-lg sm:text-xl text-black mb-10">
                        Identifica't com a Gymcreamer per dos vies:
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-10">
                        <!-- Via 1: LÍNIA OFICIAL -->
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <span class="font-mono text-xs text-gray-400">01</span>
                                <div class="h-px flex-1 bg-gray-300"></div>
                            </div>
                            <h3 class="font-display font-black text-xl sm:text-2xl uppercase tracking-wide text-black mb-3">
                                Línia Oficial
                            </h3>
                            <p class="font-serif text-sm sm:text-base text-gray-700 leading-relaxed text-justify">
                                Per als qui prefereixen la comoditat de rebre les peces confeccionades amb patrons Heavy Oversize (amb gramatges de 240-400) i el distintiu físic Gym Cream de la nostra botiga que n'acredita originalitat.
                            </p>
                            <a href="/botiga" data-astro-reload class="inline-flex items-center gap-1.5 mt-4 font-display text-xs font-bold uppercase tracking-wider text-black hover:text-gray-600 transition-colors border-b border-black hover:border-gray-600 pb-0.5">
                                Ves a la botiga
                            </a>
                        </div>

                        <!-- Via 2: FES-T'HO TU -->
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <span class="font-mono text-xs text-gray-400">02</span>
                                <div class="h-px flex-1 bg-gray-300"></div>
                            </div>
                            <h3 class="font-display font-black text-xl sm:text-2xl uppercase tracking-wide text-black mb-3">
                                Fes-t'ho Tu
                            </h3>
                            <p class="font-serif text-sm sm:text-base text-gray-700 leading-relaxed text-justify">
                                Gym Cream trenca el proteccionisme clàssic de les marques esportives. Vam néixer amb una idea molt clara: compartir els nostres logotips i actius gràfics de franc. No creiem en guardar logos com si fossin secrets d'Estat. Descarrega els vectors de franc, fes servir paper trànsfer o demana-ho en algun lloc d'internet i estampa't la samarreta tu mateix.
                            </p>
                        </div>
                    </div>

                    <!-- 3 CAIXES DE LOGOS (sense la insígnia) -->
                    <div id="descarges" class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-10 scroll-mt-24">
                        <template x-for="asset in assets.filter(a => a.category !== 'badge')" :key="asset.id">
                            <div class="bg-white border border-gray-200 p-5 flex flex-col justify-between hover:border-gray-400 transition-colors group">
                                <div>
                                    <div class="aspect-square bg-[#FAF9F5] border border-gray-200 p-6 flex items-center justify-center mb-4 relative overflow-hidden">
                                        <img :src="asset.previewImage" :alt="asset.title" class="max-h-full max-w-full object-contain transition-transform group-hover:scale-105" />
                                        <span class="absolute top-2 right-2 bg-white text-gray-600 font-mono text-[9px] px-2 py-0.5 border border-gray-200" x-text="asset.colorVariant"></span>
                                    </div>
                                    <h4 class="font-serif font-bold text-base text-black mb-1.5" x-text="asset.title"></h4>
                                    <p class="font-serif text-gray-600 text-xs leading-relaxed mb-4" x-text="asset.description"></p>
                                </div>

                                <div class="pt-3 border-t border-gray-100 space-y-3">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[10px] text-gray-500 font-mono">Formats:</span>
                                        <template x-for="fmt in asset.formats" :key="fmt">
                                            <span class="bg-gray-100 text-gray-800 text-[9px] font-mono font-bold px-1.5 py-0.5 border border-gray-200" x-text="fmt"></span>
                                        </template>
                                    </div>
                                    <a 
                                        :href="asset.fileUrl" 
                                        :download="asset.title" 
                                        class="w-full bg-black hover:bg-gcYellow hover:text-black text-white font-sans text-xs uppercase tracking-wider font-bold py-2.5 px-3 transition-colors flex items-center justify-center gap-2 cursor-pointer"
                                    >
                                        Descarregar Arxiu
                                    </a>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- LLICÈNCIA D'ÚS: continuació directa, sense secció apart -->
                <div id="llicencia" class="max-w-2xl sm:max-w-3xl mx-auto mt-16 pt-10 border-t border-gray-300 text-gray-800 font-serif">
                    <h3 class="font-serif font-bold text-lg sm:text-xl text-black mb-1">
                        Llicència d'Ús de la Marca Gym Cream (Creative Commons BY-NC)
                    </h3>
                    <p class="text-xs text-gray-500 font-mono mb-8">Normes d'ús personal i prohibició comercial</p>

                    <div class="space-y-8">
                        <div>
                            <h4 class="font-serif font-bold text-sm text-emerald-800 uppercase tracking-wide mb-2">
                                Ús Personal (Permès i Fomentat)
                            </h4>
                            <p class="text-sm sm:text-base leading-relaxed text-gray-700 text-justify">
                                Tothom té permís per descarregar i utilitzar els arxius de la marca per fabricar-se les seves pròpies samarretes, tovalloles, gorres o accessoris exclusivament per a ús propi o per a regal no lucratiu.
                            </p>
                        </div>

                        <div>
                            <h4 class="font-serif font-bold text-sm text-red-700 uppercase tracking-wide mb-2">
                                Ús Comercial (Prohibit sense autorització)
                            </h4>
                            <p class="text-sm sm:text-base leading-relaxed text-red-700 text-justify">
                                Queda totalment prohibida la comercialització, revenda, producció en massa o utilització de la marca Gym Cream per part de tercers (gimnasos, marques o particulars) amb finalitats lucratives directes o indirectes sense permís.
                            </p>
                        </div>
                    </div>
                </div>
            </Container>
        </section>


    </main>
</Layout>

<script is:inline define:vars={{ fallbackAssets: FALLBACK_BRAND_ASSETS }}>
    const registerOpenBrandState = () => {
        if (!window.Alpine) return;
        Alpine.data('openBrandState', () => ({
            assets: fallbackAssets,

            async init() {
                try {
                    const res = await fetch('/api/cms/BrandAssets');
                    if (res.ok) {
                        const assets = await res.json();
                        if (Array.isArray(assets) && assets.length > 0) this.assets = assets;
                    }
                } catch (e) {}
            }
        }));
    };

    if (window.Alpine) {
        registerOpenBrandState();
    } else {
        document.addEventListener('alpine:init', registerOpenBrandState);
    }

    document.addEventListener('astro:page-load', () => {
        registerOpenBrandState();
        if (window.Alpine) {
            window.Alpine.initTree(document.body);
        }
    });
</script>
