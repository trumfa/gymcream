---
import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import translations from "@utils/t.ts";

const nav = translations(Astro.url);

// Fitxers reals a /public/logos/{black,primary,white}/ — estàtics, no
// gestionats des del Sheet perquè són arxius de marca fixos, no
// contingut que canviï sovint.
const LOGO_EXTENSIONS = ["ai", "eps", "jpg", "pdf", "png", "svg"];

function buildFiles(folder: string, filename: string) {
	return LOGO_EXTENSIONS.map((ext) => ({
		ext: ext.toUpperCase(),
		href: `/logos/${folder}/${encodeURIComponent(`${filename}.${ext}`)}`,
	}));
}

const logoVariants = [
	{
		title: nav.gc_logo_black_title,
		description: nav.gc_logo_black_desc,
		previewSrc: "/logos/black/logo%20black%20GC.png",
		previewBg: "bg-[#FAF9F5]",
		files: buildFiles("black", "logo black GC"),
	},
	{
		title: nav.gc_logo_primary_title,
		description: nav.gc_logo_primary_desc,
		previewSrc: "/logos/primary/logo%20primari%20GC.png",
		previewBg: "bg-[#FAF9F5]",
		files: buildFiles("primary", "logo primari GC"),
	},
	{
		title: nav.gc_logo_white_title,
		description: nav.gc_logo_white_desc,
		previewSrc: "/logos/white/logo%20white%20GC.png",
		previewBg: "bg-black",
		files: buildFiles("white", "logo white GC"),
	},
];
---

<Layout title={nav.gc_meta_title} description={nav.gc_meta_description}>
    <!-- CONTINGUT PRINCIPAL OPEN BRAND — ESTÈTICA 'L'ART DE L'ANTÍTESI' -->

    <main 
        class="pt-20 sm:pt-24 bg-gcClassic text-black min-h-screen"
        x-data="{ isFromQR: false, init() { const params = new URLSearchParams(window.location.search); this.isFromQR = params.get('from') === 'qr' || params.get('source') === 'card' || params.get('utm_source') === 'qr' || params.get('utm_medium') === 'card'; } }"
    >
        <!-- BANNER DE BENVINGUDA QR (SEEDING / TARGETES) -->
        <template x-if="isFromQR">
            <div class="bg-black text-white border-b-2 border-gcYellow py-4 px-4 shadow-xl">
                <Container>
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
                        <div class="flex items-center gap-3">
                            <span class="bg-gcYellow text-black font-display font-black text-xs px-2.5 py-1 uppercase rounded-sm shrink-0">QR VIP</span>
                            <p class="font-sans text-xs sm:text-sm text-gray-200">
                                <strong class="text-gcYellow font-bold">Benvingut Gymcreamer!</strong> Has escanejat la teva targeta de regal. Digues la teva o descarrega els nostres logos gratuïts:
                            </p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <a href="/#comunitat" class="bg-gcYellow text-black hover:bg-white font-display font-bold text-[11px] uppercase tracking-wider px-3 py-1.5 transition-colors rounded-sm">
                                Proposa Frase
                            </a>
                            <a href="#descarges" class="border border-gray-600 hover:border-white text-white font-display font-bold text-[11px] uppercase tracking-wider px-3 py-1.5 transition-colors rounded-sm">
                                Logos DIY
                            </a>
                        </div>
                    </div>
                </Container>
            </div>
        </template>


    </main>
</Layout>
