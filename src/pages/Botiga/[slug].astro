---
// Pàgina individual de producte, generada EN VIU (prerender = false):
// cada visita llegeix el Sheet en temps real, així que un producte
// nou o editat té URL funcional immediatament, sense necessitat de
// cap redeploy.
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import { getSheet } from "@src/lib/cms";
import { getLocale, getLocaleUrl } from "astro-i18n-aut";
import translations from "@utils/t.ts";

const currentLocale = getLocale(Astro.url);
const nav = translations(Astro.url);

const { slug } = Astro.params;
// L'id del producte és sempre el tros final del slug, després de
// l'últim guió (el slug complet és {nom-en-slug}-{id}).
const productId = slug?.split("-").pop();

let product: any = null;
let categories: any[] = [];

try {
	const [products, cats] = await Promise.all([
		getSheet<any>("Products", currentLocale),
		getSheet<any>("Categories", currentLocale),
	]);
	product = products.find((p) => String(p.id) === String(productId)) || null;
	categories = cats;
} catch (err) {
	console.error("Error carregant el producte:", err);
}

// Producte no trobat (id inexistent, esborrat del Sheet, URL mal
// escrita...) -> 404 real, no una pàgina en blanc.
if (!product) {
	return new Response(null, { status: 404 });
}

const categoryMatch = categories.find((c) => (c.slug || c.name) === product.category);
const categoryLabel = categoryMatch ? categoryMatch.name : product.category;

const images: string[] = Array.isArray(product.images) && product.images.length > 0
	? product.images
	: [product.imageFront, product.imageBack].filter(Boolean);

const isSoldOut = product.isSoldOut || (product.stock !== undefined && Number(product.stock) <= 0);
const pageTitle = `${product.name} | Gym Cream`;
const pageDescription = (product.description || nav.botiga_title || "").slice(0, 160);

const botigaUrl = getLocaleUrl("/botiga", currentLocale);

// Dades estructurades JSON-LD de tipus Product — habiliten resultats
// enriquits a Google (preu, disponibilitat, imatge) per a aquest
// producte en concret.
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.description,
	image: images,
	sku: product.sku,
	brand: { "@type": "Brand", name: "Gym Cream" },
	offers: {
		"@type": "Offer",
		url: new URL(Astro.url.pathname, Astro.site).toString(),
		priceCurrency: "EUR",
		price: product.price,
		availability: isSoldOut
			? "https://schema.org/OutOfStock"
			: "https://schema.org/InStock",
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: nav.nav_inici, item: new URL(getLocaleUrl("/", currentLocale), Astro.site).toString() },
		{ "@type": "ListItem", position: 2, name: nav.nav_botiga, item: new URL(botigaUrl, Astro.site).toString() },
		{ "@type": "ListItem", position: 3, name: product.name, item: new URL(Astro.url.pathname, Astro.site).toString() },
	],
};
---

<Layout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<div class="pt-20 sm:pt-24 bg-white min-h-screen">
		<Container>
			<div class="py-8 sm:py-12">
				<!-- Breadcrumb -->
				<nav class="text-xs text-gray-500 font-sans mb-6 flex items-center gap-2 flex-wrap">
					<a href={getLocaleUrl("/", currentLocale)} data-astro-reload class="hover:text-black transition-colors">{nav.nav_inici}</a>
					<span>/</span>
					<a href={botigaUrl} data-astro-reload class="hover:text-black transition-colors">{nav.nav_botiga}</a>
					<span>/</span>
					<span class="text-black font-bold" set:text={product.name}></span>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14">
					<!-- Galeria d'imatges -->
					<div class="space-y-3">
						<div class="aspect-[3/4] bg-[#FAF9F5] overflow-hidden rounded-sm border border-gray-200">
							<img src={images[0]} alt={product.name} class="w-full h-full object-cover" />
						</div>
						{images.length > 1 && (
							<div class="grid grid-cols-4 gap-3">
								{images.slice(1).map((img) => (
									<div class="aspect-square bg-[#FAF9F5] overflow-hidden rounded-sm border border-gray-200">
										<img src={img} alt={`${product.name} detall`} class="w-full h-full object-cover" />
									</div>
								))}
							</div>
						)}
					</div>

					<!-- Info del producte -->
					<div>
						<div class="text-xs font-sans font-bold text-gray-500 uppercase tracking-widest mb-2" set:text={categoryLabel}></div>
						<h1 class="font-serif text-3xl sm:text-4xl font-bold text-black mb-4" set:text={product.name}></h1>

						<div class="flex items-baseline gap-3 mb-6">
							{(product.oldPrice || product.isSale) && (
								<span class="font-sans text-lg text-gray-400 line-through">
									{(product.oldPrice ? Number(product.oldPrice) : Number(product.price) * 1.25).toFixed(2)} €
								</span>
							)}
							<span class="font-sans text-2xl font-black text-black">{Number(product.price).toFixed(2)} €</span>
							{isSoldOut && (
								<span class="bg-red-600 text-white font-sans text-[10px] font-bold px-2.5 py-1 uppercase tracking-wider">{nav.badge_esgotat}</span>
							)}
						</div>

						{product.description && (
							<p class="font-sans text-sm text-gray-700 leading-relaxed mb-6" set:text={product.description}></p>
						)}

						{Array.isArray(product.details) && product.details.length > 0 && (
							<ul class="space-y-1.5 mb-8 font-sans text-xs text-gray-600">
								{product.details.map((d: string) => (
									<li class="flex items-start gap-2">
										<span class="text-black">•</span>
										<span set:text={d}></span>
									</li>
								))}
							</ul>
						)}

						{Array.isArray(product.sizes) && product.sizes.length > 0 && (
							<div class="mb-8">
								<div class="text-xs font-display font-bold uppercase tracking-widest text-gray-500 mb-2">{nav.modal_selecciona_talla}</div>
								<div class="flex flex-wrap gap-2">
									{product.sizes.map((sz: string) => (
										<span class="border border-gray-300 text-black text-xs font-bold px-3 py-1.5 rounded-sm" set:text={sz}></span>
									))}
								</div>
							</div>
						)}

						<!-- Obre el modal complet (talla + quantitat + afegir al carret) ja existent -->
						<button
							id="open-full-product-modal"
							data-product={JSON.stringify(product)}
							class="w-full bg-black text-white font-display font-black text-sm uppercase py-4 hover:bg-gcYellow hover:text-black transition-all cursor-pointer rounded-sm"
						>
							{isSoldOut ? nav.modal_esgotat_btn : nav.btn_info_detalls}
						</button>

						<a href={botigaUrl} data-astro-reload class="block text-center mt-4 text-xs font-sans text-gray-500 hover:text-black transition-colors underline">
							{nav.nav_botiga}
						</a>
					</div>
				</div>
			</div>
		</Container>
	</div>
</Layout>

<script>
	// Botó de la pàgina de producte -> obre el mateix modal complet que
	// ja fa servir tota la resta del catàleg (talla, quantitat, afegir
	// al carret), sense duplicar cap lògica de carret.
	const btn = document.getElementById("open-full-product-modal");
	if (btn) {
		btn.addEventListener("click", () => {
			const product = JSON.parse(btn.getAttribute("data-product") || "{}");
			window.dispatchEvent(new CustomEvent("open-product-modal", { detail: product }));
		});
	}
</script>
