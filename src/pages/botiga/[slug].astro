---
// Pàgina individual de producte, generada 100% EN ESTÀTIC al moment
// del build (com totes les altres). Una pàgina .html real per cada
// producte, per cada idioma — no hi ha cap funció que s'executi en
// cada visita, així que no hi pot haver mai cap timeout ni error 500
// per lentitud d'Apps Script. Per veure un producte nou o editat cal
// que es dispari un build nou (el Deploy Hook connectat al Sheet
// s'encarrega d'això automàticament).

import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import { getLocale, getLocaleUrl } from "astro-i18n-aut";
import translations from "@utils/t.ts";
import { SITE_URL } from "@src/consts";
import { getSheet } from "@src/lib/cms";

// getStaticPaths() només s'executa UNA VEGADA (no per idioma) — aquí
// només decidim QUINS productes existeixen i quin slug (nom+id) té
// cadascun. El contingut real de cada idioma es demana més avall,
// al cos de la pàgina, que SÍ es torna a executar per cada idioma.
export async function getStaticPaths() {
	const products = await getSheet<any>("Products", "ca");
	return products.map((p: any) => {
		const slug = String(p.name || "producte")
			.normalize("NFD").replace(/[\u0300-\u036f]/g, "")
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/(^-|-$)/g, "");
		return { params: { slug: `${slug}-${p.id}` } };
	});
}

const currentLocale = getLocale(Astro.url);
const nav = translations(Astro.url);

const { slug } = Astro.params;
const productId = slug?.split("-").pop();

let product: any = null;
let categories: any[] = [];
let products: any[] = [];

try {
	const [productsData, catsData] = await Promise.all([
		getSheet<any>("Products", currentLocale),
		getSheet<any>("Categories", currentLocale),
	]);
	products = Array.isArray(productsData) ? productsData : [];
	categories = Array.isArray(catsData) ? catsData : [];
	product = products.find((p: any) => String(p.id) === String(productId)) || null;
} catch (err) {
	console.error("[botiga/[slug]] Error carregant el producte durant el build:", err);
}

const siteBase = SITE_URL;

let categoryLabel = product?.category || "";
let images: string[] = [];
let isSoldOut = false;
let pageTitle = "Gym Cream";
let pageDescription = "";
let botigaUrl = "/botiga";
let productSchema: any = null;
let breadcrumbSchema: any = null;

if (product) {
	try {
		const categoryMatch = categories.find((c) => (c.slug || c.name) === product.category);
		categoryLabel = categoryMatch ? categoryMatch.name : product.category;

		images = Array.isArray(product.images) && product.images.length > 0
			? product.images
			: [product.imageFront, product.imageBack].filter(Boolean);

		isSoldOut = !!product.isSoldOut || (product.stock !== undefined && Number(product.stock) <= 0);
		pageTitle = `${product.name || "Producte"} | Gym Cream`;
		pageDescription = (product.description || nav.botiga_title || "").toString().slice(0, 160);

		botigaUrl = getLocaleUrl("/botiga", currentLocale);

		const currentFullUrl = new URL(Astro.url.pathname, siteBase).toString();

		productSchema = {
			"@context": "https://schema.org",
			"@type": "Product",
			name: product.name,
			description: product.description,
			image: images,
			sku: product.sku,
			brand: { "@type": "Brand", name: "Gym Cream" },
			offers: {
				"@type": "Offer",
				url: currentFullUrl,
				priceCurrency: "EUR",
				price: product.price,
				availability: isSoldOut
					? "https://schema.org/OutOfStock"
					: "https://schema.org/InStock",
			},
		};

		breadcrumbSchema = {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: nav.nav_inici, item: new URL(getLocaleUrl("/", currentLocale), siteBase).toString() },
				{ "@type": "ListItem", position: 2, name: nav.nav_botiga, item: new URL(botigaUrl, siteBase).toString() },
				{ "@type": "ListItem", position: 3, name: product.name, item: currentFullUrl },
			],
		};
	} catch (err) {
		console.error("[botiga/[slug]] Error preparant les dades de la pàgina:", err);
	}
}
---

<Layout
	title={pageTitle}
	description={pageDescription}
	products={products}
	categories={categories}
>
	{productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
	{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

	<div class="pt-20 sm:pt-24 bg-white min-h-screen">
		<Container>
			{!product ? (
				<div class="py-24 text-center">
					<p class="font-serif text-lg text-gray-600">Aquest producte ja no està disponible.</p>
					<a href={botigaUrl} data-astro-reload class="inline-block mt-4 underline text-black">{nav.nav_botiga}</a>
				</div>
			) : (
			<div class="py-8 sm:py-12">
				<!-- Breadcrumb -->
				<nav class="text-xs text-gray-500 font-sans mb-6 flex items-center gap-2 flex-wrap">
					<a href={getLocaleUrl("/", currentLocale)} data-astro-reload class="hover:text-black transition-colors">{nav.nav_inici}</a>
					<span>/</span>
					<a href={botigaUrl} data-astro-reload class="hover:text-black transition-colors">{nav.nav_botiga}</a>
					<span>/</span>
					<span class="text-black font-bold" set:text={product.name}></span>
				</nav>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14">
					<!-- Galeria d'imatges -->
					<div class="space-y-3">
						<div class="aspect-[3/4] bg-[#FAF9F5] overflow-hidden rounded-sm border border-gray-200">
							<img src={images[0]} alt={product.name} class="w-full h-full object-cover" />
						</div>
						{images.length > 1 && (
							<div class="grid grid-cols-4 gap-3">
								{images.slice(1).map((img) => (
									<div class="aspect-square bg-[#FAF9F5] overflow-hidden rounded-sm border border-gray-200">
										<img src={img} alt={`${product.name} detall`} class="w-full h-full object-cover" />
									</div>
								))}
							</div>
						)}
					</div>

					<!-- Info del producte -->
					<div>
						<div class="text-xs font-sans font-bold text-gray-500 uppercase tracking-widest mb-2" set:text={categoryLabel}></div>
						<h1 class="font-serif text-3xl sm:text-4xl font-bold text-black mb-4" set:text={product.name}></h1>

						<div class="flex items-baseline gap-3 mb-6">
							{(product.oldPrice || product.isSale) && (
								<span class="font-sans text-lg text-gray-400 line-through">
									{(product.oldPrice ? Number(product.oldPrice) : Number(product.price) * 1.25).toFixed(2)} €
								</span>
							)}
							<span class="font-sans text-2xl font-black text-black">{Number(product.price).toFixed(2)} €</span>
							{isSoldOut && (
								<span class="bg-red-600 text-white font-sans text-[10px] font-bold px-2.5 py-1 uppercase tracking-wider">{nav.badge_esgotat}</span>
							)}
						</div>

						{product.description && (
							<p class="font-sans text-sm text-gray-700 leading-relaxed mb-6" set:text={product.description}></p>
						)}

						{Array.isArray(product.details) && product.details.length > 0 && (
							<ul class="space-y-1.5 mb-8 font-sans text-xs text-gray-600">
								{product.details.map((d: string) => (
									<li class="flex items-start gap-2">
										<span class="text-black">•</span>
										<span set:text={d}></span>
									</li>
								))}
							</ul>
						)}

						{Array.isArray(product.sizes) && product.sizes.length > 0 && (
							<div class="mb-8">
								<div class="text-xs font-display font-bold uppercase tracking-widest text-gray-500 mb-2">{nav.modal_selecciona_talla}</div>
								<div class="flex flex-wrap gap-2">
									{product.sizes.map((sz: string) => (
										<span class="border border-gray-300 text-black text-xs font-bold px-3 py-1.5 rounded-sm" set:text={sz}></span>
									))}
								</div>
							</div>
						)}

						<!-- Obre el modal complet (talla + quantitat + afegir al carret) ja existent -->
						<button
							id="open-full-product-modal"
							data-product={JSON.stringify(product)}
							class="w-full bg-black text-white font-display font-black text-sm uppercase py-4 hover:bg-gcYellow hover:text-black transition-all cursor-pointer rounded-sm"
						>
							{isSoldOut ? nav.modal_esgotat_btn : nav.btn_info_detalls}
						</button>

						<a href={botigaUrl} data-astro-reload class="block text-center mt-4 text-xs font-sans text-gray-500 hover:text-black transition-colors underline">
							{nav.nav_botiga}
						</a>
					</div>
				</div>
			</div>
			)}
		</Container>
	</div>
</Layout>

<script>
	const btn = document.getElementById("open-full-product-modal");
	if (btn) {
		btn.addEventListener("click", () => {
			const product = JSON.parse(btn.getAttribute("data-product") || "{}");
			window.dispatchEvent(new CustomEvent("open-product-modal", { detail: product }));
		});
	}
</script>
