            x-transition:leave-end="opacity-0"
            class="fixed inset-0 bg-black/90 z-[150] flex items-center justify-center p-4 backdrop-blur-md"
            x-cloak
        >
            <div class="bg-gcDark border-2 border-gcYellow/60 w-full max-w-lg p-6 space-y-4 text-white shadow-2xl">
