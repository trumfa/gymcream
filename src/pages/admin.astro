---
import Layout from "@layouts/Layout.astro";
import { DEFAULT_PHRASES, DEFAULT_CATEGORIES, DEFAULT_SLIDES, DEFAULT_PRODUCTS } from "@src/data/cmsDefaults";
---

<Layout title="Gestor de Contingut (CMS) | Gym Cream">
    <div x-data="cmsApp" class="min-h-screen bg-black text-white pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        
        <!-- LOGIN GATE: SI NO ESTÀ AUTENTICAT -->
        <template x-if="!authenticatedUser">
            <div class="min-h-[65vh] flex flex-col items-center justify-center text-center px-4">
                <div class="max-w-md w-full bg-zinc-950 border-2 border-gcYellow/60 p-8 sm:p-10 shadow-[0_0_50px_rgba(255,230,0,0.1)] space-y-6 relative overflow-hidden text-left">
                    <div class="absolute -right-12 -top-12 w-32 h-32 bg-gcYellow/10 rounded-full blur-2xl pointer-events-none"></div>
                    
                    <div class="flex items-center justify-center">
                        <div class="inline-flex p-4 bg-black border border-gcYellow/40 rounded-full shadow-inner mb-2">
                            <svg class="w-10 h-10 text-gcYellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                    </div>
                    
                    <div class="text-center">
                        <span class="bg-gcYellow text-black text-[10px] font-black uppercase tracking-widest px-2.5 py-1">
                            Accés Protegit CMS
                        </span>
                        <h2 class="font-display text-2xl font-black uppercase tracking-tight text-white mt-3">
                            Panell de Control CMS
                        </h2>
                        <p class="text-gray-400 text-xs mt-2 leading-relaxed">
                            Introdueix la contrasenya d'administrador per gestionar el catàleg, carrusel i frases en temps real.
                        </p>
                    </div>

                    <!-- OPCIÓ 1: ACCÉS PER CONTRASENYA / PIN (100% GARANTIT SENSE DEPENDRE D'OAUTH) -->
                    <form @submit.prevent="loginWithPassword()" class="space-y-4 pt-2">
                        <div>
                            <label class="block text-[11px] font-display uppercase tracking-wider text-gray-300 font-bold mb-1.5">
                                Contrasenya d'Administrador
                            </label>
                            <input 
                                type="password" 
                                x-model="adminPasswordInput"
                                placeholder="Introdueix la clau..."
                                class="w-full bg-black border border-gray-800 focus:border-gcYellow text-white p-3 text-sm focus:outline-none transition-colors font-mono"
                                required
                            />
                            <template x-if="passwordError">
                                <p class="text-xs text-red-400 mt-1.5 font-sans font-medium" x-text="passwordError"></p>
                            </template>
                        </div>

                        <button 
                            type="submit"
                            class="w-full bg-gcYellow text-black hover:bg-white font-display font-black text-xs uppercase tracking-wider py-3.5 px-6 transition-all duration-300 cursor-pointer flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(255,230,0,0.3)]"
                        >
                            <span>Entrar al CMS</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </button>

                        <div class="p-3 bg-black/60 border border-gray-900 text-[11px] text-gray-400 font-mono text-center">
                            💡 Clau per defecte: <span class="text-gcYellow font-bold">gymcream2026</span> (es pot personalitzar després).
                        </div>
                    </form>

                    <!-- DIVIDER -->
                    <div class="relative flex py-1 items-center">
                        <div class="flex-grow border-t border-gray-900"></div>
                        <span class="flex-shrink mx-3 text-[10px] text-gray-600 font-mono uppercase">O també</span>
                        <div class="flex-grow border-t border-gray-900"></div>
                    </div>

                    <!-- OPCIÓ 2: GITHUB OAUTH -->
                    <button 
                        @click="loginWithGithub()" 
                        :disabled="isAuthenticating"
                        type="button"
                        class="w-full bg-zinc-900 hover:bg-zinc-800 text-gray-200 border border-zinc-700 font-display font-bold text-xs uppercase tracking-wider py-3 px-4 transition-all duration-300 cursor-pointer flex items-center justify-center gap-3 disabled:opacity-50"
                    >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        <span x-text="isAuthenticating ? 'Obrint GitHub...' : 'Inicia Sessió amb GitHub'"></span>
                    </button>

                    <div class="text-center pt-2">
                        <a href="/" class="text-xs text-gray-500 hover:text-white underline transition-colors">Tornar a la Botiga</a>
                    </div>
                </div>
            </div>
        </template>

        <!-- CMS CONTINGUT COMPLET: NOMÉS SI ESTÀ AUTENTICAT -->
        <template x-if="authenticatedUser">
            <div>
                <!-- HEADER DEL CMS AMB INFORMACIÓ DE L'USUARI -->
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-b border-gray-800 pb-8 mb-8">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <span class="bg-gcYellow text-black text-[10px] font-black uppercase tracking-widest px-2.5 py-1">
                                Panell Administratiu
                            </span>
                            <span class="text-xs text-gray-400 font-mono">v2.0 • GitHub Authenticated</span>
                        </div>
                        <h1 class="font-display text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center gap-3">
                            Gestor de Continguts (CMS)
                        </h1>
                        <p class="text-gray-400 text-sm mt-1">Gestiona frases iròniques, menú/filtres, carrusel d'inici i articles del catàleg en temps real.</p>
                    </div>

                    <div class="flex items-center gap-3 flex-wrap">
                        <!-- TARGETA USUARI AUTENTICAT -->
                        <div class="flex items-center gap-3 bg-zinc-900 border border-gray-800 p-2 px-3 rounded">
                            <img :src="authenticatedUser.avatar_url" class="w-8 h-8 rounded-full border border-gcYellow" :alt="authenticatedUser.login" />
                            <div class="text-left">
                                <div class="font-bold text-white text-xs flex items-center gap-1">
                                    <span x-text="authenticatedUser.name"></span>
                                    <span class="text-gray-500 font-mono text-[10px]" x-text="`(@${authenticatedUser.login})`"></span>
                                </div>
                                <div class="text-[10px] text-emerald-400 font-mono" x-text="authenticatedUser.login === 'admin' ? '● Sessió d\'Administrador' : '● Sessió de GitHub Activa'"></div>
                            </div>
                            <button 
                                @click="changeAdminPassword()" 
                                class="ml-2 bg-zinc-800 hover:bg-zinc-700 text-gcYellow text-[10px] font-bold uppercase tracking-wider px-2.5 py-1.5 border border-zinc-700 rounded transition-colors cursor-pointer"
                                title="Canviar Contrasenya d'Accés"
                            >
                                🔑 Clau
                            </button>
                            <button 
                                @click="logout()" 
                                class="bg-red-950 hover:bg-red-900 text-red-200 text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 border border-red-800 rounded transition-colors cursor-pointer"
                                title="Tancar Sessió"
                            >
                                Surt
                            </button>
                        </div>

                        <a href="/" class="bg-gray-900 hover:bg-gray-800 text-gray-200 border border-gray-700 font-display text-xs uppercase tracking-wider px-4 py-3 transition-colors flex items-center gap-2">
                            <svg class="w-4 h-4 text-gcYellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                            Botiga
                        </a>
                        <button 
                            @click="resetDefaults()" 
                            class="bg-red-950/80 hover:bg-red-900 text-red-200 border border-red-800 font-display text-xs uppercase tracking-wider px-4 py-3 transition-colors flex items-center gap-2"
                            title="Restablir dades inicials"
                        >
                            <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            Restablir Dades
                        </button>
                    </div>
                </div>

        <!-- NOTIFICACIÓ TOAST CMS -->
        <div 
            x-show="toast.show" 
            x-transition:enter="transition ease-out duration-300 transform"
            x-transition:enter-start="translate-y-full opacity-0"
            x-transition:enter-end="translate-y-0 opacity-100"
            x-transition:leave="transition ease-in duration-200 transform"
            x-transition:leave-start="translate-y-0 opacity-100"
            x-transition:leave-end="translate-y-full opacity-0"
            class="fixed bottom-6 right-6 z-[200] max-w-md bg-gcDark border-2 border-gcYellow text-white p-4 shadow-2xl flex items-center gap-3"
            x-cloak
        >
            <div class="bg-gcYellow text-black p-2 rounded-full">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <p class="font-sans text-sm font-semibold" x-text="toast.message"></p>
        </div>

        <!-- NAVEGACIÓ PER PESTANYES / TABS -->
        <div class="flex border-b border-gray-800 mb-8 overflow-x-auto gap-2">
            <button 
                @click="activeTab = 'products'" 
                :class="activeTab === 'products' ? 'border-gcYellow text-gcYellow bg-gray-900/80 font-bold' : 'border-transparent text-gray-400 hover:text-white hover:bg-gray-950'"
                class="px-6 py-4 font-display text-xs uppercase tracking-widest border-b-2 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer"
            >
                <span>📦</span> Articles / Productes (<span x-text="products.length"></span>)
            </button>
            <button 
                @click="activeTab = 'phrases'" 
                :class="activeTab === 'phrases' ? 'border-gcYellow text-gcYellow bg-gray-900/80 font-bold' : 'border-transparent text-gray-400 hover:text-white hover:bg-gray-950'"
                class="px-6 py-4 font-display text-xs uppercase tracking-widest border-b-2 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer"
            >
                <span>📢</span> Frases Ticker (<span x-text="phrases.length"></span>)
            </button>
            <button 
                @click="activeTab = 'categories'" 
                :class="activeTab === 'categories' ? 'border-gcYellow text-gcYellow bg-gray-900/80 font-bold' : 'border-transparent text-gray-400 hover:text-white hover:bg-gray-950'"
                class="px-6 py-4 font-display text-xs uppercase tracking-widest border-b-2 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer"
            >
                <span>🏷️</span> Menú / Categories (<span x-text="categories.length"></span>)
            </button>
            <button 
                @click="activeTab = 'slides'" 
                :class="activeTab === 'slides' ? 'border-gcYellow text-gcYellow bg-gray-900/80 font-bold' : 'border-transparent text-gray-400 hover:text-white hover:bg-gray-950'"
                class="px-6 py-4 font-display text-xs uppercase tracking-widest border-b-2 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer"
            >
                <span>🎬</span> Carrusel d'Inici (<span x-text="slides.length"></span>)
            </button>
        </div>

        <!-- ========================================== -->
        <!-- TAB 1: ARTICLES / PRODUCTES -->
        <!-- ========================================== -->
        <div x-show="activeTab === 'products'" class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-4 bg-gray-950 p-4 border border-gray-900">
                <div class="relative flex-1">
                    <input 
                        type="text" 
                        x-model="productSearch" 
                        placeholder="Buscar per nom, categoria o SKU..." 
                        class="w-full bg-black border border-gray-800 text-white px-4 py-2.5 text-sm focus:border-gcYellow focus:outline-none"
                    />
                </div>
                <button 
                    @click="openProductModal()" 
                    class="bg-gcYellow text-black font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors flex items-center justify-center gap-2 cursor-pointer shadow"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg>
                    Afegir Nou Article
                </button>
            </div>

            <!-- TAULA DE PRODUCTES -->
            <div class="overflow-x-auto border border-gray-900 bg-gray-950">
                <table class="w-full text-left text-xs font-sans">
                    <thead class="bg-gray-900 text-gray-300 font-display uppercase tracking-wider text-[11px] border-b border-gray-800">
                        <tr>
                            <th class="p-3">Foto</th>
                            <th class="p-3">Nom / SKU</th>
                            <th class="p-3">Categoria</th>
                            <th class="p-3">Preu / Descompte</th>
                            <th class="p-3">Estoc</th>
                            <th class="p-3">Etiqueta</th>
                            <th class="p-3 text-right">Accions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-900">
                        <template x-for="(prod, index) in filteredProducts" :key="prod.id">
                            <tr class="hover:bg-gray-900/60 transition-colors">
                                <td class="p-3">
                                    <img :src="prod.imageFront" :alt="prod.name" class="w-12 h-14 object-cover bg-black border border-gray-800" />
                                </td>
                                <td class="p-3">
                                    <div class="font-bold text-white text-sm" x-text="prod.name"></div>
                                    <div class="text-[10px] text-gray-500 font-mono" x-text="prod.sku || 'Sense SKU'"></div>
                                </td>
                                <td class="p-3">
                                    <span class="bg-gray-900 border border-gray-800 text-gray-300 text-[10px] uppercase font-bold px-2 py-1" x-text="prod.category"></span>
                                </td>
                                <td class="p-3">
                                    <div class="font-bold text-gcYellow" x-text="`${prod.price.toFixed(2)} €`"></div>
                                    <template x-if="prod.oldPrice">
                                        <div class="text-[10px] text-gray-500 line-through" x-text="`${prod.oldPrice.toFixed(2)} € (${prod.discountPercent || 0}% desc)`"></div>
                                    </template>
                                </td>
                                <td class="p-3">
                                    <span 
                                        :class="prod.stock <= 0 ? 'bg-red-950 text-red-400 border-red-800' : 'bg-emerald-950 text-emerald-300 border-emerald-800'"
                                        class="px-2.5 py-1 text-[10px] font-bold border uppercase"
                                        x-text="prod.stock <= 0 ? '0 (ESGOTAT)' : `${prod.stock} unitats`"
                                    ></span>
                                </td>
                                <td class="p-3">
                                    <template x-if="prod.badge">
                                        <span class="bg-gcYellow text-black font-extrabold text-[9px] px-2 py-0.5 uppercase tracking-wider" x-text="prod.badge"></span>
                                    </template>
                                    <template x-if="!prod.badge">
                                        <span class="text-gray-600 italic text-[10px]">-</span>
                                    </template>
                                </td>
                                <td class="p-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button 
                                            @click="openProductModal(prod)" 
                                            class="bg-gray-900 hover:bg-gcYellow hover:text-black text-gray-300 px-3 py-1.5 border border-gray-700 transition-colors text-[10px] font-bold uppercase cursor-pointer"
                                        >
                                            Editar
                                        </button>
                                        <button 
                                            @click="deleteProduct(prod.id)" 
                                            class="bg-red-950 hover:bg-red-800 text-red-200 px-3 py-1.5 border border-red-900 transition-colors text-[10px] font-bold uppercase cursor-pointer"
                                        >
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: FRASES TICKER IRÒNIQUES -->
        <!-- ========================================== -->
        <div x-show="activeTab === 'phrases'" class="space-y-6">
            <div class="bg-gray-950 p-6 border border-gray-900 space-y-4">
                <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gcYellow">Afegir Nova Frase Irònica</h3>
                <div class="flex gap-3">
                    <input 
                        type="text" 
                        x-model="newPhrase" 
                        placeholder="Exemple: 'NO ET RENDIXIS, EL DIA DE CAMA ÉS NOMÉS EL COMENÇAMENT...'" 
                        class="flex-1 bg-black border border-gray-800 text-white p-3 text-sm focus:border-gcYellow focus:outline-none"
                    />
                    <button 
                        @click="addPhrase()" 
                        class="bg-gcYellow text-black font-display font-black text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors cursor-pointer"
                    >
                        Afegir Frase
                    </button>
                </div>
            </div>

            <div class="space-y-3">
                <template x-for="(phrase, index) in phrases" :key="index">
                    <div class="flex items-center justify-between gap-4 bg-gray-950 p-4 border border-gray-900 hover:border-gray-800">
                        <div class="flex items-center gap-3 flex-1">
                            <span class="font-mono text-xs text-gcYellow/70 font-bold" x-text="`#${index + 1}`"></span>
                            <input 
                                type="text" 
                                x-model="phrases[index]" 
                                @change="savePhrases()" 
                                class="w-full bg-black border border-gray-800 text-gray-200 p-2.5 text-sm focus:border-gcYellow focus:outline-none"
                            />
                        </div>
                        <div class="flex items-center gap-2">
                            <button @click="movePhrase(index, -1)" :disabled="index === 0" class="p-2 text-gray-400 hover:text-white disabled:opacity-30 cursor-pointer">▲</button>
                            <button @click="movePhrase(index, 1)" :disabled="index === phrases.length - 1" class="p-2 text-gray-400 hover:text-white disabled:opacity-30 cursor-pointer">▼</button>
                            <button @click="deletePhrase(index)" class="p-2 text-red-500 hover:text-red-400 cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 3: MENÚ DE CATEGORIES / FILTRES -->
        <!-- ========================================== -->
        <div x-show="activeTab === 'categories'" class="space-y-6">
            <div class="bg-gray-950 p-6 border border-gray-900 space-y-4">
                <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gcYellow">Afegir Nova Categoria al Menú</h3>
                <div class="flex gap-3">
                    <input 
                        type="text" 
                        x-model="newCategoryName" 
                        placeholder="Exemple: 'SUPLEMENTS', 'EDICIÓ LIMITADA'..." 
                        class="flex-1 bg-black border border-gray-800 text-white p-3 text-sm focus:border-gcYellow focus:outline-none uppercase"
                    />
                    <button 
                        @click="addCategory()" 
                        class="bg-gcYellow text-black font-display font-black text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors cursor-pointer"
                    >
                        Afegir Categoria
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <template x-for="(cat, index) in categories" :key="cat.id">
                    <div class="bg-gray-950 p-4 border border-gray-900 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3 flex-1">
                            <span class="font-mono text-xs text-gcYellow font-bold" x-text="`#${index + 1}`"></span>
                            <input 
                                type="text" 
                                x-model="cat.name" 
                                @change="saveCategories()" 
                                class="bg-black border border-gray-800 text-white p-2.5 text-sm font-display uppercase tracking-wider w-full focus:border-gcYellow focus:outline-none"
                            />
                        </div>
                        <div class="flex items-center gap-2">
                            <button @click="moveCategory(index, -1)" :disabled="index === 0" class="p-1.5 text-gray-400 hover:text-white disabled:opacity-30 cursor-pointer">▲</button>
                            <button @click="moveCategory(index, 1)" :disabled="index === categories.length - 1" class="p-1.5 text-gray-400 hover:text-white disabled:opacity-30 cursor-pointer">▼</button>
                            <button @click="deleteCategory(index)" class="p-1.5 text-red-500 hover:text-red-400 cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 4: CARRUSEL D'INICI (HERO SLIDES) -->
        <!-- ========================================== -->
        <div x-show="activeTab === 'slides'" class="space-y-6">
            <div class="flex justify-between items-center bg-gray-950 p-4 border border-gray-900">
                <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gcYellow">Gestió de Diapositives (Fotos i Vídeos)</h3>
                <button 
                    @click="openSlideModal()" 
                    class="bg-gcYellow text-black font-display font-black text-xs uppercase tracking-wider px-6 py-3 hover:bg-white transition-colors cursor-pointer"
                >
                    Afegir Diapositiva
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <template x-for="(slide, index) in slides" :key="slide.id">
                    <div class="bg-gray-950 border border-gray-900 flex flex-col justify-between overflow-hidden">
