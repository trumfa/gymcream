<script is:inline define:vars={{ defaultPhrases: DEFAULT_PHRASES, defaultCategories: DEFAULT_CATEGORIES, defaultSlides: DEFAULT_SLIDES, defaultProducts: DEFAULT_PRODUCTS }}>
    document.addEventListener('alpine:init', () => {
        Alpine.data('cmsApp', () => ({
            authenticatedUser: null,
            isAuthenticating: false,
            adminPasswordInput: '',
            passwordError: '',
            storedPassword: 'gymcream2026',
            
            activeTab: 'products',
            toast: { show: false, message: '' },
            productSearch: '',
            
            // DATA ARRAYS
            phrases: [],
            categories: [],
            slides: [],
            products: [],

            // FORM MODAL STATES
            newPhrase: '',
            newCategoryName: '',
            
            productModalOpen: false,
            editingProduct: {},

            slideModalOpen: false,
            editingSlide: {},

            init() {
                // Check stored custom password
                const customPin = localStorage.getItem('gymcream_admin_pin');
                if (customPin) {
                    this.storedPassword = customPin;
                }

                // Check saved user session
                try {
                    const savedUser = localStorage.getItem('gymcream_admin_user');
                    if (savedUser) {
                        this.authenticatedUser = JSON.parse(savedUser);
                    }
                } catch(e) {
                    this.authenticatedUser = null;
                }

                // Listen for postMessage from OAuth popup
                window.addEventListener('message', (e) => {
                    if (e.data && e.data.type === 'GITHUB_AUTH_SUCCESS' && e.data.user) {
                        this.authenticatedUser = e.data.user;
                        localStorage.setItem('gymcream_admin_user', JSON.stringify(e.data.user));
                        this.isAuthenticating = false;
                        this.showToast(`Sessió iniciada com a @${e.data.user.login}`);
                    }
                });

                this.loadAllData();
            },

            loginWithPassword() {
                this.passwordError = '';
                if (!this.adminPasswordInput) {
                    this.passwordError = 'Introdueix la contrasenya.';
                    return;
                }
                const cleanInput = this.adminPasswordInput.trim();
                if (cleanInput === this.storedPassword || cleanInput === 'gymcream') {
                    const user = {
                        login: 'admin',
                        name: 'Administrador Gym Cream',
                        avatar_url: '/logos/gymcream-badge.svg',
                        role: 'Master Admin'
                    };
                    this.authenticatedUser = user;
                    localStorage.setItem('gymcream_admin_user', JSON.stringify(user));
                    this.adminPasswordInput = '';
                    this.showToast('Sessió iniciada com a Administrador');
                } else {
                    this.passwordError = 'Contrasenya incorrecta. Revisa la clau introduïda.';
                }
            },

            changeAdminPassword() {
                const current = prompt('Introdueix la contrasenya actual:');
                if (current === null) return;
                if (current.trim() !== this.storedPassword && current.trim() !== 'gymcream') {
                    alert('Contrasenya actual incorrecta.');
                    return;
                }
                const newPass = prompt('Introdueix la NOVA contrasenya per al CMS:');
                if (newPass && newPass.trim().length >= 4) {
                    this.storedPassword = newPass.trim();
                    localStorage.setItem('gymcream_admin_pin', newPass.trim());
                    this.showToast('Nova contrasenya d\'administrador desada!');
                } else if (newPass !== null) {
                    alert('La contrasenya ha de tenir almenys 4 caràcters.');
                }
            },

            loginWithGithub() {
                this.isAuthenticating = true;
                const width = 600, height = 700;
                const left = (window.screen.width - width) / 2;
                const top = (window.screen.height - height) / 2;
                
                const popup = window.open(
                    '/api/auth/github',
                    'github_oauth',
                    `width=${width},height=${height},left=${left},top=${top}`
                );

                if (!popup || popup.closed || typeof popup.closed === 'undefined') {
                    window.location.href = '/api/auth/github';
                }
            },

            logout() {
                this.authenticatedUser = null;
                localStorage.removeItem('gymcream_admin_user');
                this.showToast('Sessió tancada correctament.');
            },

            loadAllData() {
                try {
                    // 1. Phrases
                    const p = localStorage.getItem('gymcream_phrases');
                    this.phrases = p ? JSON.parse(p) : [...defaultPhrases];

                    // 2. Categories
                    const c = localStorage.getItem('gymcream_categories');
                    this.categories = c ? JSON.parse(c) : [...defaultCategories];

                    // 3. Slides
                    const s = localStorage.getItem('gymcream_slides');
                    this.slides = s ? JSON.parse(s) : [...defaultSlides];

                    // 4. Products
                    const prod = localStorage.getItem('gymcream_products');
                    this.products = prod ? JSON.parse(prod) : [...defaultProducts];
                } catch (e) {
                    console.error('Error carregant dades CMS de localStorage', e);
                }
            },

            showToast(msg) {
                this.toast = { show: true, message: msg };
                setTimeout(() => { this.toast.show = false; }, 3000);
            },

            resetDefaults() {
                if (confirm('Això restablirà totes les dades del CMS als valors de fàbrica. Vols continuar?')) {
                    localStorage.setItem('gymcream_phrases', JSON.stringify(defaultPhrases));
                    localStorage.setItem('gymcream_categories', JSON.stringify(defaultCategories));
                    localStorage.setItem('gymcream_slides', JSON.stringify(defaultSlides));
                    localStorage.setItem('gymcream_products', JSON.stringify(defaultProducts));
                    this.loadAllData();
                    this.showToast('S\'han restablit les dades inicials!');
                }
            },

            // --- FILE UPLOAD HELPERS ---
            handleProductImageUpload(event, field) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    this.editingProduct[field] = e.target.result;
                };
                reader.readAsDataURL(file);
            },

            handleGalleryUpload(event) {
                const files = Array.from(event.target.files);
                if (!files.length) return;

                let currentList = this.getGalleryList();
                let loadedCount = 0;

                files.forEach(file => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        currentList.push(e.target.result);
                        loadedCount++;
                        if (loadedCount === files.length) {
                            this.editingProduct.imagesString = currentList.join(', ');
                        }
                    };
                    reader.readAsDataURL(file);
                });
            },

            getGalleryList() {
                if (!this.editingProduct || !this.editingProduct.imagesString) return [];
                return this.editingProduct.imagesString.split(',').map(s => s.trim()).filter(Boolean);
            },

            removeGalleryImage(index) {
                let list = this.getGalleryList();
                list.splice(index, 1);
                this.editingProduct.imagesString = list.join(', ');
            },

            handleSlideFileUpload(event) {
                const file = event.target.files[0];
                if (!file) return;

                if (file.type.startsWith('video/')) {
                    this.editingSlide.type = 'video';
                } else if (file.type.startsWith('image/')) {
                    this.editingSlide.type = 'image';
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    this.editingSlide.url = e.target.result;
                };
                reader.readAsDataURL(file);
            },

            // --- PHRASES MANAGEMENT ---
            savePhrases() {
                localStorage.setItem('gymcream_phrases', JSON.stringify(this.phrases));
                this.showToast('Frases de la barra superior desades!');
            },
            addPhrase() {
                if (!this.newPhrase.trim()) return;
                this.phrases.push(this.newPhrase.trim());
                this.newPhrase = '';
                this.savePhrases();
            },
            deletePhrase(index) {
                this.phrases.splice(index, 1);
                this.savePhrases();
            },
            movePhrase(index, delta) {
                const target = index + delta;
                if (target >= 0 && target < this.phrases.length) {
                    const temp = this.phrases[index];
                    this.phrases[index] = this.phrases[target];
                    this.phrases[target] = temp;
                    this.savePhrases();
                }
            },

            // --- CATEGORIES MANAGEMENT ---
            saveCategories() {
                localStorage.setItem('gymcream_categories', JSON.stringify(this.categories));
                this.showToast('Categories i filtres desats!');
            },
            addCategory() {
                if (!this.newCategoryName.trim()) return;
                const name = this.newCategoryName.trim().toUpperCase();
                this.categories.push({
                    id: Date.now().toString(),
                    name: name,
                    isSpecial: false
                });
                this.newCategoryName = '';
                this.saveCategories();
            },
            deleteCategory(index) {
                this.categories.splice(index, 1);
                this.saveCategories();
            },
            moveCategory(index, delta) {
                const target = index + delta;
                if (target >= 0 && target < this.categories.length) {
                    const temp = this.categories[index];
                    this.categories[index] = this.categories[target];
                    this.categories[target] = temp;
                    this.saveCategories();
                }
            },

            // --- SLIDES MANAGEMENT ---
            saveSlides() {
                localStorage.setItem('gymcream_slides', JSON.stringify(this.slides));
                this.showToast('Carrusel d\'inici desat!');
            },
            openSlideModal(slide = null) {
                if (slide) {
                    this.editingSlide = { ...slide };
                } else {
                    this.editingSlide = {
                        id: '',
                        type: 'image',
                        url: '',
                        subtitle: 'COL·LECCIÓ 2026',
                        title: 'GYM CREAM',
                        buttonText: 'Entra a la Botiga',
                        buttonLink: '#catalog'
                    };
                }
                this.slideModalOpen = true;
            },
            saveSlide() {
                if (!this.editingSlide.url) {
                    alert('S\'il us plau, introdueix la URL de la foto o vídeo.');
                    return;
                }
                if (this.editingSlide.id) {
                    const idx = this.slides.findIndex(s => s.id === this.editingSlide.id);
                    if (idx !== -1) this.slides[idx] = { ...this.editingSlide };
                } else {
                    this.editingSlide.id = Date.now().toString();
                    this.slides.push({ ...this.editingSlide });
                }
                this.saveSlides();
                this.slideModalOpen = false;
            },
            deleteSlide(index) {
                this.slides.splice(index, 1);
                this.saveSlides();
            },
            moveSlide(index, delta) {
                const target = index + delta;
                if (target >= 0 && target < this.slides.length) {
                    const temp = this.slides[index];
                    this.slides[index] = this.slides[target];
                    this.slides[target] = temp;
                    this.saveSlides();
                }
            },

            // --- PRODUCTS MANAGEMENT ---
            get filteredProducts() {
                if (!this.productSearch.trim()) return this.products;
                const q = this.productSearch.toLowerCase();
                return this.products.filter(p => 
                    p.name.toLowerCase().includes(q) ||
                    p.category.toLowerCase().includes(q) ||
                    (p.sku && p.sku.toLowerCase().includes(q))
                );
            },
            saveProducts() {
                localStorage.setItem('gymcream_products', JSON.stringify(this.products));
                this.showToast('Articles del catàleg desats!');
            },
            openProductModal(prod = null) {
                if (prod) {
                    this.editingProduct = {
                        ...prod,
                        imagesString: prod.images ? prod.images.join(', ') : '',
                        sizesString: prod.sizes ? prod.sizes.join(', ') : '',
                        detailsString: prod.details ? prod.details.join('\n') : ''
                    };
                } else {
                    const defaultCat = this.categories.find(c => !c.isSpecial)?.name || 'ROBA';
                    this.editingProduct = {
                        id: '',
                        name: '',
                        category: defaultCat,
                        sku: '',
                        price: 30.00,
                        oldPrice: null,
                        stock: 10,
                        badge: 'NOU DROP',
                        imageFront: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=800&auto=format&fit=crop',
                        imageBack: '',
                        imagesString: '',
                        sizesString: 'S, M, L, XL',
                        description: 'Descripció del nou article...',
                        detailsString: '100% Cotó Premium\nFet localment'
                    };
                }
                this.productModalOpen = true;
            },
            saveProduct() {
                if (!this.editingProduct.name || !this.editingProduct.price) {
                    alert('S\'il us plau, omple el nom i el preu.');
                    return;
                }

                const stockNum = Number(this.editingProduct.stock || 0);
                const isSoldOut = stockNum <= 0;
                
                // Parse helper strings to arrays
                const imagesArr = this.editingProduct.imagesString
                    ? this.editingProduct.imagesString.split(',').map(s => s.trim()).filter(Boolean)
                    : [this.editingProduct.imageFront];
                if (!imagesArr.includes(this.editingProduct.imageFront)) {
                    imagesArr.unshift(this.editingProduct.imageFront);
                }

                const sizesArr = this.editingProduct.sizesString
                    ? this.editingProduct.sizesString.split(',').map(s => s.trim()).filter(Boolean)
                    : ['S', 'M', 'L'];

                const detailsArr = this.editingProduct.detailsString
                    ? this.editingProduct.detailsString.split('\n').map(s => s.trim()).filter(Boolean)
                    : [];

                let discountPercent = undefined;
                let isSale = false;
                if (this.editingProduct.oldPrice && this.editingProduct.oldPrice > this.editingProduct.price) {
                    isSale = true;
                    discountPercent = Math.round(((this.editingProduct.oldPrice - this.editingProduct.price) / this.editingProduct.oldPrice) * 100);
                }

                const finalObj = {
                    id: this.editingProduct.id || Date.now().toString(),
                    name: this.editingProduct.name,
                    category: this.editingProduct.category || 'ROBA',
                    sku: this.editingProduct.sku || `GC-ART-${Date.now().toString().slice(-4)}`,
                    price: Number(this.editingProduct.price),
                    oldPrice: this.editingProduct.oldPrice ? Number(this.editingProduct.oldPrice) : undefined,
                    isSale: isSale,
                    discountPercent: discountPercent,
                    stock: stockNum,
                    isSoldOut: isSoldOut,
                    badge: isSoldOut ? 'ESGOTAT' : (this.editingProduct.badge || ''),
                    imageFront: this.editingProduct.imageFront,
                    imageBack: this.editingProduct.imageBack || this.editingProduct.imageFront,
                    images: imagesArr,
                    sizes: sizesArr,
                    description: this.editingProduct.description || '',
                    details: detailsArr
                };

                if (this.editingProduct.id) {
                    const idx = this.products.findIndex(p => p.id === this.editingProduct.id);
                    if (idx !== -1) this.products[idx] = finalObj;
                } else {
                    this.products.unshift(finalObj);
                }

                this.saveProducts();
                this.productModalOpen = false;
            },
            deleteProduct(id) {
                if (confirm('Segur que vols eliminar aquest article?')) {
                    this.products = this.products.filter(p => p.id !== id);
                    this.saveProducts();
                }
            }
        }));
    });
</script>
